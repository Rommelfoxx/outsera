{
  "dependencies": {
    "cypress": "^16.1.1"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^28.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@cypress/webpack-preprocessor": "^8.0.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cypress-cucumber-preprocessor": "^4.3.1",
    "eslint": "^10.12.0",
    "eslint-plugin-cypress": "^7.0.2",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "globals": "^17.13.0",
    "mochawesome": "^8.1.1",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "webpack": "^5.111.1"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:cypress": "eslint cypress",
    "db": "node scripts/init_db.js",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:qa": "CYPRESS_ENV=qa cypress run",
    "cypress:staging": "CYPRESS_ENV=staging cypress run",
    "cypress:prod": "CYPRESS_ENV=production cypress run",
    "cypress:api": "cypress run --spec 'cypress/e2e/api/**/*.cy.js'",
    "cypress:api:qa": "CYPRESS_ENV=qa npm run cypress:api",
    "cypress:ui": "cypress run --spec 'cypress/e2e/ui/**/*.feature'",
    "cypress:ui:dev": "CYPRESS_ENV=dev npm run cypress:ui",
    "cypress:ui:qa": "CYPRESS_ENV=qa npm run cypress:ui",
    "report:merge": "mochawesome-merge cypress/reports/mocha/.jsons/*.json -o cypress/reports/mocha/merged.json",
    "report:generate": "marge cypress/reports/mocha/merged.json -o cypress/reports/html"
  }
}